<!DOCTYPE html>
<html>

<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <title>BuySellHub</title>
</head>

<body class="bg-gray-100 min-h-screen">
    <nav class="bg-blue-600 p-4 text-white shadow-lg">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold">BuySellHub</h1>
            <a href="/signup" class="bg-white text-blue-600 px-4 py-2 rounded hover:bg-gray-100">Signup</a>
        </div>
    </nav>
    <main class="max-w-4xl mx-auto p-8">
        <h2 class="text-4xl font-bold text-gray-800 mb-6">Login to BuySellHub</h2>
        <% if (error) { %>
            <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
                <p class="font-semibold">
                    <%= error %>
                </p>
            </div>
            <% } %>
                <form method="post" class="max-w-md bg-white p-8 rounded-lg shadow-lg">
                    <input type="email" name="email" placeholder="Email" class="w-full p-3 border rounded mb-4">
                    <input type="password" name="password" placeholder="Password"
                        class="w-full p-3 border rounded mb-6">
                    <button type="submit"
                        class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold">Login</button>
                </form>
    </main>

</body>

</html>