<!DOCTYPE html>
<html>

<head>
    <title>
        <%= product.title %> - BuySellHub
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen">
    <%- include('partials/header') %>
        <main class="max-w-4xl mx-auto p-6">
            <a href="/products" class="text-blue-600 text-sm">&larr; Back to listings</a>

            <div class="mt-6 bg-white rounded-2xl p-6 shadow">
                <img src="<%= product.imageURL %>" alt="<%= product.title %>"
                    class="w-full max-h-96 object-cover rounded-lg mb-6">

                <h1 class="text-3xl font-bold mb-2">
                    <%= product.title %>
                </h1>
                <p class="text-2xl font-semibold text-blue-600 mb-4">₹<%= product.price %>
                </p>

                <p class="text-gray-700 mb-4">
                    <%= product.description %>
                </p>

                <p class="text-sm text-gray-500">
                    Seller: <%= product.seller?.name || 'Unknown' %>
                </p>
            </div>
        </main>
        <%- include('partials/footer') %>

</body>

</html>