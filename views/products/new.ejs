<!DOCTYPE html>
<html>

<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <title>New Listing - BuySellHub</title>
</head>

<body class="bg-gray-100 min-h-screen">
      <nav class="bg-blue-600 p-4 text-white shadow-lg">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/" class="text-2xl font-bold">BuySellHub</a>

      <div class="flex items-center space-x-4">
        <a href="/products" class="hover:underline">Browse Listings</a>

        <% if (user) { %>
          <span class="text-sm">Welcome, <%= user.name %>!</span>
          <a href="/products/new" class="bg-white text-blue-600 px-4 py-2 rounded-lg font-semibold hover:bg-gray-100">
            + New Listing
          </a>
          <a href="/logout" class="hover:underline">Logout</a>
          <% } else { %>
            <a href="/login" class="hover:underline">Login</a>
            <a href="/signup" class="hover:underline">Sign Up</a>
            <% } %>
      </div>
    </div>
  </nav>

    <main class="max-w-2xl mx-auto p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Create New Listing</h1>
        <% if (error) { %>
            <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
                <p class="font-semibold">
                    <%= error %>
                </p>
            </div>
            <% } %>

                <% if (success) { %>
                    <div class="mb-6 bg-green-100 border border-green-400 text-green-800 px-4 py-3 rounded">
                        <p class="font-semibold">
                            <%= success %>
                        </p>
                    </div>
                    <% } %>

                        <form method="POST" action="/products" novalidate class="bg-white p-8 rounded-xl shadow-lg">
                            <div class="mb-6">
                                <label class="block text-gray-700 font-semibold mb-2">Title</label>
                                <input type="text" name="title" required
                                    class="w-full p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="e.g. Used Laptop i5 8GB RAM">
                            </div>

                            <div class="mb-6">
                                <label class="block text-gray-700 font-semibold mb-2">Price (₹)</label>
                                <input type="number" name="price" required step="0.01"
                                    class="w-full p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="e.g. 25000">
                            </div>

                            <div class="mb-6">
                                <label class="block text-gray-700 font-semibold mb-2">Description</label>
                                <textarea name="description" required rows="5"
                                    class="w-full p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="Describe your item... condition, usage, reason for selling, etc."></textarea>
                            </div>

                            <div class="mb-8">
                                <label class="block text-gray-700 font-semibold mb-2">Image URL (optional)</label>
                                <input type="url" name="imageURL"
                                    class="w-full p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="https://example.com/your-image.jpg">
                            </div>

                            <button type="submit"
                                class="w-full bg-blue-600 text-white py-4 px-8 rounded-lg font-semibold text-lg hover:bg-blue-700 transition-colors">
                                Post Listing
                            </button>
                        </form>
    </main>
</body>

</html>